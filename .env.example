LIQUIDATION_FEE_BPS=50
# Share of collected fees paid to keepers (docs/9_treasury_fees.md); the rest is LP revenue
KEEPER_SHARE_BPS=3000
# Borrow fee (docs/10_borrow_fee.md): per second x10^12; 27778 = 0.01% of size per hour (Midnight)
BORROW_RATE=27778
# Ethereum mainnet RPC for Chainlink (public, no key)
EVM_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Dry-run vault (step-5 code, TRADER as admin), for tests before the real vault ---
DRY_RUN_VAULT_ID=CCWX2ATXVSGSORYNJCIPSIEYK26I4AWMPHYQVI2AB3ATPROJYWYSYTXS

# --- Treasury: owner of every close's fee note (docs/7_close_position.md) ---
