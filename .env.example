# ZKPerp testnet configuration.
# .env holds SECRETS (*_SECRET, KEEPER_VIEW_SK) and is gitignored.
# .env.example is the same file with every secret left empty.
# See "docs/1_setup wallets and .env.md".

# --- Network ---
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# --- USDC (Circle testnet USDC; drop-in for mUSDC later) ---
